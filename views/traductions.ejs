<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Traducciones</title>
  <link rel="stylesheet" href="/stylesheets/components.css">
  <link rel="stylesheet" href="/stylesheets/traductions.css">
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>
</head>
<body>
    <%- include('partials/navbar.ejs') %>

  <main>
    <section class="traductions-intro card" style="margin-top:var(--space-lg);">
      <h2 style="color:var(--color-primary-dark);">Traduce tus documentos en minutos</h2>
      <p style="color:var(--color-text-light); font-size:1.1rem;">Carga tu archivo, elige el idioma y recibe tu traducción profesional de forma rápida y segura.</p>
    </section>
    <section class="traductions-steps card">
      <h2 style="color:var(--color-primary-dark);">¿Cómo funciona?</h2>
      <ol style="padding-left:1.2em;">
        <li>Sube tu documento (PDF, Word, Excel, etc.)</li>
        <li>Selecciona el idioma de origen y destino</li>
        <li>Confirma el pago y recibe tu traducción</li>
      </ol>
    </section>
    <section class="traductions-benefits card">
      <h2 style="color:var(--color-primary-dark);">Ventajas de LoveDoc</h2>
      <ul style="padding-left:1.2em;">
        <li>✔️ Traducción automática y humana</li>
        <li>✔️ Seguridad y confidencialidad</li>
        <li>✔️ Soporte en todo momento</li>
      </ul>
    </section>
    <section class="translation-types card">
      <h2>Tipos de Traducción</h2>
      <div class="types-container">
        <div class="type">
          <h3>📜 Traducción estándar</h3>
          <p>Rápida y automática, ideal para textos simples.</p>
        </div>
        <div class="type">
          <h3>⚖ Traducción legal</h3>
          <p>Especializada en contratos, certificados y documentos jurídicos.</p>
        </div>
        <div class="type">
          <h3>📘 Traducción académica</h3>
          <p>Artículos científicos, investigaciones y tesis con revisión experta.</p>
        </div>
        <div class="type">
          <h3>🏢 Traducción corporativa</h3>
          <p>Manuales, informes y documentos empresariales con formato profesional.</p>
        </div>
        <div class="type">
          <h3>🔍 Revisión y corrección</h3>
          <p>Corrección gramatical y adaptación precisa al idioma destino.</p>
        </div>
        <div class="type">
          <h3>🛡 Traducción certificada</h3>
          <p>Documentos con validez legal y certificación oficial.</p>
        </div>
        <div class="type">
          <h3>💡 Localización de contenido</h3>
          <p>Adaptación de sitios web y software para distintos mercados.</p>
        </div>
        <div class="type">
          <h3>🚀 Traducción en tiempo real</h3>
          <p>Traducción instantánea para reuniones, chats y conferencias online.</p>
        </div>
      </div>
    </section>

    <section class="upload-section">
      <h2>Sube tu documento</h2>
      <form action="/translate" method="POST" enctype="multipart/form-data">
        <label for="document">Selecciona el archivo:</label>
        <input type="file" id="document" name="document" accept=".pdf,.docx,.txt" required>

        <label for="language">Selecciona el idioma de destino:</label>
        <input type="text" id="languageInput" name="language" list="languages" placeholder="Escribe un idioma..." required>
        <datalist id="languages">
          <option value="Español">
          <option value="Inglés">
          <option value="Francés">
          <option value="Alemán">
          <option value="Italiano">
          <option value="Chino">
          <option value="Portugués">
          <option value="Japonés">
          <option value="Coreano">
          <option value="Ruso">
        </datalist>

        <button type="submit">Traducir ahora</button>
      </form>
    </section>

    <section class="translation-benefits">
      <h2>¿Por qué usar LoveDoc?</h2>
      <ul>
        <li>✅ Traducción precisa con IA avanzada</li>
        <li>🚀 Rápido y seguro</li>
        <li>🌎 Compatible con múltiples idiomas</li>
        <li>📂 Soporte para formatos PDF, DOCX y TXT</li>
      </ul>
    </section>

    <section class="recent-translations">
      <h2>Traducciones recientes</h2>
      <div class="translation-example">
        <p><strong>Documento:</strong> Manual técnico</p>
        <p><strong>Idioma origen:</strong> Inglés</p>
        <p><strong>Idioma destino:</strong> Español</p>
        <a href="/download/example1">Descargar traducción</a>
      </div>
      <div class="translation-example">
        <p><strong>Documento:</strong> Informe de negocios</p>
        <p><strong>Idioma origen:</strong> Francés</p>
        <p><strong>Idioma destino:</strong> Inglés</p>
        <a href="/download/example2">Descargar traducción</a>
      </div>
    </section>
  </main>

  <footer>
    <p>&copy; 2025 LoveDoc - Todos los derechos reservados</p>
  </footer>
  <script src="/scripts/scripts.js"></script>
</body>
</html>