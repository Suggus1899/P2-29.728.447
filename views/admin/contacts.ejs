<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Contactos - LoveDoc</title>
    <link rel="stylesheet" href="/stylesheets/admin_contact.css">
    <link rel="stylesheet" href="/stylesheets/components.css">
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
</head>

<body>
    <%- include('../partials/navbar.ejs') %>

    <main>
        <div class="card-table">
            <h2 style="color:var(--color-primary-dark);">Lista de Contactos</h2>

            <% if (typeof message !== "undefined" && message) { %>
                <div class="alert alert-success"><%= message %></div>
            <% } %>

            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Tipo</th>
                        <th>Comentario</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (contacts && contacts.length > 0) { %>
                        <% contacts.forEach(contact => { %>
                            <tr>
                                <td><%= contact.nombre %></td>
                                <td><%= contact.email %></td>
                                <td><%= contact.tipo_mensaje %></td>
                                <td><%= contact.comment %></td>
                                <td><%= contact.created_at %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="5">No hay contactos registrados.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <p>&copy; 2025 LoveDoc. Todos los derechos reservados.</p>
    </footer>
    <script src="/scripts/scripts.js"></script>
</body>
</html>