<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagos Registrados - LoveDoc</title>
    <link rel="stylesheet" href="/stylesheets/admin_payment.css">
    <link rel="stylesheet" href="/stylesheets/components.css">
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
</head>
<body>
    <%- include('../partials/navbar.ejs') %>

    <main>
        <div class="card-table">
            <h2 style="color:var(--color-primary-dark);">Lista de Pagos Registrados</h2>

            <% if (message) { %>
                <div class="alert alert-error"><%= message %></div>
            <% } %>

            <table class="table">
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Monto</th>
                        <th>Moneda</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (payments && payments.length > 0) { %>
                        <% payments.forEach(payment => { %>
                            <tr>
                                <td><%= payment.service %></td>
                                <td><%= payment.cardName %></td>
                                <td><%= payment.email %></td>
                                <td><%= payment.amount %></td>
                                <td><%= payment.currency %></td>
                                <td><%= payment.created_at %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="6">No hay pagos registrados.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <p>&copy; 2025 LoveDoc - Todos los derechos reservados.</p>
    </footer>
    <script src="/scripts/scripts.js"></script>
</body>
</html>