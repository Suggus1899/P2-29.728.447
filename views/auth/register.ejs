<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title><%= title || "Registrarse" %> | LoveDoc</title>
  <link rel="stylesheet" href="/stylesheets/register.css" />
  <link rel="stylesheet" href="/stylesheets/components.css" />
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>
</head>
<body>
  <!-- Navbar -->
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">LoveDoc</a>
      <ul class="nav-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/login">Iniciar sesión</a></li>
      </ul>
      <div class="hamburger-menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </div>
    </div>
  </nav>

  <main class="form-container card">
    <h1 style="text-align:center; color:var(--color-primary-dark);">Crear cuenta</h1>

    <% if (message) { %>
      <div class="alert alert-error"><%= message %></div>
    <% } %>

    <form method="POST" action="/register">
      <label for="username">Usuario</label>
      <input type="text" id="username" name="username" class="input" required />

      <label for="email">Correo electrónico</label>
      <input type="email" id="email" name="email" class="input" required />

      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" class="input" required />

      <button type="submit" class="btn">Registrarse</button>
    </form>
    <div style="text-align:center; margin-top:var(--space-sm);">
      <a href="/login" class="btn" style="background:var(--color-secondary);">¿Ya tienes cuenta? Inicia sesión</a>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> LoveDoc. Todos los derechos reservados.</p>
  </footer>
  <script src="/scripts/scripts.js"></script>
</body>
</html>