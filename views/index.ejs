<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <!-- Etiquetas Open Graph para redes sociales -->
  <meta property="og:title" content="<%= title || 'LoveDoc - Traducción de documentos' %>" />
  <meta property="og:description" content="Convierte y traduce tus documentos de forma rápida, segura y profesional con LoveDoc. Más de 50 idiomas disponibles. ¡Pruébalo gratis!" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= url || 'https://lovedoc.com' %>" />
  <meta property="og:image" content="/public/logo-og.png" />
  <meta property="og:locale" content="es_ES" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= title || 'LoveDoc - Traducción de documentos' %>" />
  <meta name="twitter:description" content="Convierte y traduce tus documentos de forma rápida, segura y profesional con LoveDoc. Más de 50 idiomas disponibles. ¡Pruébalo gratis!" />
  <meta name="twitter:image" content="/public/logo-og.png" />
  <link rel="stylesheet" type="text/css" href="/stylesheets/index.css" />
  <link rel="stylesheet" type="text/css" href="/stylesheets/components.css" />
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>
</head>
<body>
    <%- include('partials/navbar.ejs') %>

  <main>
    <!-- Sección HERO -->
    <section class="hero card" style="text-align:center; margin-top:var(--space-lg);">
      <h2 style="font-size:2.2rem; font-weight:600; color:var(--color-primary-dark);">Traducción de documentos rápida y eficiente</h2>
      <p style="font-size:1.15rem; color:var(--color-text-light); max-width:600px; margin:var(--space-sm) auto;">Convierte cualquier documento en el idioma que necesites, con precisión y calidad.</p>
      <a href="/traductions" class="btn" style="font-size:1.1rem;">Comenzar</a>
    </section>

    <!-- ¿Cómo funciona LoveDoc? -->
    <section class="how-it-works" style="margin:var(--space-lg) 0;">
      <h2 style="text-align:center; color:var(--color-primary-dark);">¿Cómo funciona LoveDoc?</h2>
      <div class="steps" style="display:flex; flex-wrap:wrap; justify-content:center; gap:var(--space-md); margin-top:var(--space-md);">
        <div class="step card" style="flex:1 1 220px; min-width:220px; max-width:320px;">
          <h3 style="font-size:1.1rem;">📂 1. Carga tu documento</h3>
          <p>Sube el archivo que deseas traducir en el formato admitido.</p>
        </div>
        <div class="step card" style="flex:1 1 220px; min-width:220px; max-width:320px;">
          <h3 style="font-size:1.1rem;">🌍 2. Selecciona el idioma</h3>
          <p>Elige el idioma de destino y personaliza las opciones.</p>
        </div>
        <div class="step card" style="flex:1 1 220px; min-width:220px; max-width:320px;">
          <h3 style="font-size:1.1rem;">🚀 3. Obtén tu traducción</h3>
          <p>Descarga el documento traducido con calidad profesional.</p>
        </div>
      </div>
    </section>

    <!-- Planes y precios -->
    <section class="pricing" style="margin:var(--space-lg) 0;">
      <h2 style="text-align:center; color:var(--color-primary-dark);">Planes y Precios</h2>
      <div class="plans" style="display:flex; flex-wrap:wrap; justify-content:center; gap:var(--space-md); margin-top:var(--space-md);">
        <div class="plan card" style="flex:1 1 220px; min-width:220px; max-width:320px;">
          <h3>🔹 Básico</h3>
          <p>Traducción estándar, ideal para textos simples.</p>
          <p><strong>Gratis</strong></p>
        </div>
        <div class="plan card" style="flex:1 1 220px; min-width:220px; max-width:320px;">
          <h3>⚡ Avanzado</h3>
          <p>Traducción técnica y especializada.</p>
          <p><strong>$9.99 por documento</strong></p>
        </div>
        <div class="plan card" style="flex:1 1 220px; min-width:220px; max-width:320px;">
          <h3>🏆 Premium</h3>
          <p>Traducción con revisión humana y certificación.</p>
          <p><strong>$29.99 por documento</strong></p>
        </div>
      </div>
    </section>

    <!-- Estadísticas -->
    <section class="stats">
      <h2>Impacto de LoveDoc</h2>
      <div class="stats-box">
        <div>
          <h3>🌍 +50 Idiomas soportados</h3>
          <p>Traducción precisa para todos los idiomas populares.</p>
        </div>
        <div>
          <h3>📄 +500K Documentos traducidos</h3>
          <p>Clientes satisfechos de todo el mundo.</p>
        </div>
        <div>
          <h3>🕒 95% Ahorro de tiempo</h3>
          <p>Comparado con traducciones manuales.</p>
        </div>
      </div>
    </section>

    <!-- Preguntas frecuentes (FAQ) -->
    <section class="faq">
      <h2>Preguntas frecuentes</h2>
      <div class="faq-item">
        <h3>¿LoveDoc traduce archivos PDF?</h3>
        <p>Sí, puedes subir archivos en formato PDF, DOCX y TXT.</p>
      </div>
      <div class="faq-item">
        <h3>¿Qué idiomas están disponibles?</h3>
        <p>Soportamos más de 50 idiomas, incluyendo inglés, español, francés y chino.</p>
      </div>
      <div class="faq-item">
        <h3>¿Cómo se garantiza la precisión?</h3>
        <p>Usamos tecnología avanzada y revisión humana en los planes premium.</p>
      </div>
    </section>

    <!-- Testimonios -->
    <section class="testimonials">
      <h2>Lo que dicen nuestros usuarios</h2>
      <div class="testimonial">
        <p>"LoveDoc ha transformado la forma en que traducimos documentos. ¡Increíble!"</p>
        <p><strong>María G.</strong></p>
      </div>
      <div class="testimonial">
        <p>"Rápido, fácil y preciso. No puedo pedir más."</p>
        <p><strong>John D.</strong></p>
      </div>
      <div class="testimonial">
        <p>"El mejor servicio de traducción que he usado. ¡Altamente recomendado!"</p>
        <p><strong>Li W.</strong></p>
      </div>
    </section>
  </main>

  <footer>
    <p>&copy; 2025 LoveDoc - Todos los derechos reservados</p>
  </footer>
  <script src="/scripts/scripts.js"></script>
</body>
</html>